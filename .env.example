# Copy this file to .env and fill in your values
# Get your free Anakin API keys at: https://anakin.io/dashboard
# Each key gives 300 free credits (~10 full searches)
# With 10 keys you get ~100 searches before any key rotates

ANAKIN_MCP_URL=https://mcp.anakin.io/mcp
PORT=3000

# ── API Key Pool (up to 10 keys) ────────────────────────────────────────────
# The agent rotates automatically when one hits its rate/credit limit.
# At least ANAKIN_API_KEY_1 must be set. Leave others blank if unused.
ANAKIN_API_KEY_1=ask_your_first_key_here
ANAKIN_API_KEY_2=ask_your_second_key_here
ANAKIN_API_KEY_3=ask_your_third_key_here
ANAKIN_API_KEY_4=ask_your_fourth_key_here
ANAKIN_API_KEY_5=ask_your_fifth_key_here
ANAKIN_API_KEY_6=ask_your_sixth_key_here
ANAKIN_API_KEY_7=ask_your_seventh_key_here
ANAKIN_API_KEY_8=ask_your_eighth_key_here
ANAKIN_API_KEY_9=ask_your_ninth_key_here
ANAKIN_API_KEY_10=ask_your_tenth_key_here
