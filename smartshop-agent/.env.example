# Copy this file to .env and fill in your values
# Get your free Anakin API keys at: https://anakin.io/dashboard

ANAKIN_MCP_URL=https://mcp.anakin.io/mcp
PORT=3000

# ── API Key Pool ────────────────────────────────────────────────────────────
# Add up to 4 keys. The agent rotates automatically when one hits its limit.
# At least ANAKIN_API_KEY_1 must be set. Leave others blank if unused.
ANAKIN_API_KEY_1=ask_your_first_key_here
ANAKIN_API_KEY_2=ask_your_second_key_here
ANAKIN_API_KEY_3=ask_your_third_key_here
ANAKIN_API_KEY_4=ask_your_fourth_key_here
